# Clerk Authentication
# Keys are written to .env.local by: npx clerk@latest init --accountless
# Or copy from https://dashboard.clerk.com → API Keys

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# SMTP — contact form email
# Port 587 uses STARTTLS. Port 465 uses SSL.
# SMTP_FROM is optional. If blank, mail is sent from SMTP_USER.
# CONTACT_TO_EMAIL is optional. If blank, mail goes to the site inbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=

# Google reCAPTCHA v2 — "I'm not a robot" checkbox
# Create keys at https://www.google.com/recaptcha/admin (type: Challenge v2)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Supabase — Elite Solutions USA SEO project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEO admin
SEO_SITE_ORIGIN=https://www.elitesolutionusa.com
SEO_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
SEO_ADMIN_BOOTSTRAP_USER_IDS=

# Optional Google (GSC / GA4)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Ronot chatbot (free Groq — picks an available model automatically)
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
