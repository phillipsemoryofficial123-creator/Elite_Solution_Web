# Clerk Authentication
# Keys are written to .env.local by: npx clerk@latest init --accountless
# Or copy from https://dashboard.clerk.com → API Keys

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# SMTP — contact form email
# Port 587 uses STARTTLS. Port 465 uses SSL.
# SMTP_FROM is optional. If blank, mail is sent from SMTP_USER.
# CONTACT_TO_EMAIL is optional. If blank, mail goes to the site inbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=
